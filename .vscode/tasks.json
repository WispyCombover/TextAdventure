{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: cl.exe build active file",
            "command": "cl.exe",
            "args": [
                "/Zi",
                "/EHsc",
                "/nologo",
                "/std:c++20",
                "/utf-8",
                "/I${workspaceFolder}\\include",
                "/Fo${workspaceFolder}\\build\\obj\\",
                "/Fd${workspaceFolder}\\build\\obj\\",
                "/Fe${workspaceFolder}\\build\\game.exe",
                "${workspaceFolder}\\src\\*.cpp"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$msCompile"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        },
        {
            "type": "cppbuild",
            "label": "Bygg Release (For spilltestere)",
            "command": "cl.exe",
            "args": [
                "/O2",
                "/DNDEBUG",
                "/EHsc",
                "/nologo",
                "/std:c++20",
                "/utf-8",
                "/MT",
                "/I${workspaceFolder}\\include",
                "/Fo${workspaceFolder}\\build\\release\\obj\\",
                "/Fe${workspaceFolder}\\build\\release\\game.exe",
                "${workspaceFolder}\\src\\*.cpp"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$msCompile"
            ],
            "group": "build",
            "detail": "Bygger optimalisert versjon uten debug-filer klar for deling."
        }
    ]
}
